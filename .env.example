# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name
REDIS_URL=redis://redis:6379/0

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
RELOAD=True

# App Configuration
DEBUG=True

# CORS — comma-separated origins allowed to call this API.
# Set to your deployed frontend's real URL once it exists;
# defaults to Vite's local dev port for local development.
FRONTEND_ORIGINS=http://localhost:5173

# Gemini API key — required, used by qa_service.py for the Ask feature.
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Configuration (optional in local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
