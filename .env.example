# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
RELOAD=True

# App Configuration
DEBUG=True

# JWT Security Configuration
